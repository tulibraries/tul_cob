<div class="container" id="advanced-search-facets" style="margin-top: 14px;">
<% primo_facet_names.each do |facet_name| %>
  <% if (display_facet = @response.aggregations[facet_name]) && display_facet.items.present? %>
    <% facet_config = facet_configuration_for_field(display_facet.name) %>
    <% facet_id = display_facet.name.parameterize %>
    <% facet_label_id = "#{facet_id}-label" %>
    <div class="form-group advanced-search-facet row">
      <%= label_tag facet_id, id: facet_label_id, class: "col-sm-2 control-label" do %>
        <%= facet_config.label %>
      <% end %>
      <div class="col-sm-8">
        <%= content_tag(:select, multiple: true,
          name: "f[#{display_facet.name}][]",
          id: facet_id,
          aria: { labelledby: facet_label_id },
          class: "form-control custom-select tom-select",
          data: { controller: "tom-select", "live-search": "true" },
          placeholder: "Type or select #{facet_field_label(display_facet.name).downcase.pluralize}") do %>
          <% display_facet.items.each do |facet_item| %>
            <% facet_item_presenter = facet_item_presenter(facet_config, facet_item, display_facet) %>
            <%= content_tag :option, value: facet_item.value, selected: facet_value_checked?(display_facet.name, facet_item.value) do %>
              <%= facet_item_presenter.label %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
</div>
<div class="container">
<div class="row">

    <div class="col col-sm-3 control-label">
      <span>Publication Year</span>
    </div>
    <div class="col-sm-8 d-flex justify-content-between">
    <div class="advanced-pub-date">
      <%= label_tag "range_creationdate_begin", "Publication Year (starting year)", class: "sr-only" %>
      <% facet_field = blacklight_config.facet_fields["creationdate"] %>
      <% component = LibrarySearch::RangeFormComponent.new(facet_field: facet_field) %>
      <%= render LibrarySearch::RangeInputComponent.new(
        input_name: component.begin_input_name,
        label_text: "",
        input_value: params.dig("range", facet_field.field, "begin") ,
        min_value: nil,
        max_value: nil,
        css_class: "range_begin") %>
    </div>
    <div class="pub-date-separator align-self-center">
      <span aria-hidden="true">to</span>
    </div>
    <div class="advanced-pub-date">
      <%= label_tag "range_creationdate_end", "Publication Year (ending year)", class: "sr-only" %>
      <%= render LibrarySearch::RangeInputComponent.new(
        input_name: component.end_input_name,
        label_text: "",
        input_value: params.dig("range", facet_field.field, "end") ,
        min_value: nil,
        max_value: nil,
        css_class: "range_end") %>
    </div>
  </div>
</div>
</div>
